{
  "name": "localscan",
  "private": true,
  "version": "1.10.0",
  "license": "MPL-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:online": "vite --mode online",
    "build": "tsc -b && vite build",
    "build:online": "tsc -b && vite build --mode online",
    "lint": "oxlint",
    "preview": "vite preview",
    "android:sync": "node scripts/cap-sync.mjs offline",
    "android:sync:online": "node scripts/cap-sync.mjs online",
    "android:open": "cap open android",
    "android:apk": "npm run build && npm run android:sync && cd android && gradlew.bat assembleOfflineDebug",
    "android:apk:online": "npm run build:online && npm run android:sync:online && cd android && gradlew.bat assembleOnlineDebug"
  },
  "dependencies": {
    "@capacitor-mlkit/barcode-scanning": "^8.2.1",
    "@capacitor-mlkit/text-recognition": "^8.2.1",
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/camera": "^8.2.4",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/status-bar": "^8.0.3",
    "@capawesome/capacitor-torch": "^8.0.2",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "date-fns": "^4.4.0",
    "html5-qrcode": "^2.3.8",
    "idb": "^8.0.3",
    "jsqr": "^1.4.0",
    "jszip": "^3.10.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.85.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.1"
  }
}
